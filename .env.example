# KANDOR local development configuration. Copy to .env and change every value
# marked CHANGE_ME before exposing the stack beyond localhost.
KANDOR_ENVIRONMENT=development
KANDOR_LOG_LEVEL=INFO
KANDOR_API_PORT=8000
KANDOR_UI_PORT=3000
# Compose applies Alembic before startup; do not mutate schemas from app workers.
KANDOR_AUTO_CREATE_TABLES=false

# Database and Redis
POSTGRES_DB=kandor
POSTGRES_USER=kandor_owner
POSTGRES_PASSWORD=CHANGE_ME_local_database_admin_password
# The application role is created by docker/postgres/init-app-role.sh with no
# superuser, database-creation, or role-creation privileges.
KANDOR_DB_USER=kandor
KANDOR_DB_PASSWORD=CHANGE_ME_local_database_app_password
KANDOR_DATABASE_URL=postgresql+asyncpg://kandor:CHANGE_ME_local_database_app_password@kandor-postgres:5432/kandor
REDIS_PASSWORD=CHANGE_ME_local_redis_password
KANDOR_REDIS_URL=redis://:CHANGE_ME_local_redis_password@kandor-redis:6379/0

# Generate with: openssl rand -hex 32
KANDOR_SECRET_KEY=CHANGE_ME_64_character_random_signing_secret_0000000000000000000000
KANDOR_JWT_ISSUER=kandor
KANDOR_JWT_AUDIENCE=kandor-ui
KANDOR_REFRESH_TOKEN_DAYS=7
KANDOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
KANDOR_TRUSTED_HOSTS=localhost,127.0.0.1,kandor-backend
# Compose assigns this address only to the frontend reverse proxy. Keep these
# values aligned if the proxy subnet must change due to a local network conflict.
KANDOR_PROXY_SUBNET=172.30.254.0/28
KANDOR_FRONTEND_PROXY_IP=172.30.254.10
KANDOR_FORWARDED_ALLOW_IPS=172.30.254.10

# Request and authentication abuse controls
KANDOR_MAX_REQUEST_BYTES=1048576
KANDOR_RATE_LIMIT_REQUESTS=300
KANDOR_RATE_LIMIT_WINDOW_SECONDS=60
KANDOR_LOGIN_RATE_LIMIT_REQUESTS=10

# Health and retention defaults
KANDOR_HEARTBEAT_INTERVAL_SECONDS=30
KANDOR_DEGRADED_THRESHOLD_SECONDS=60
KANDOR_OFFLINE_THRESHOLD_SECONDS=300
KANDOR_TASK_EXPIRATION_SECONDS=3600
KANDOR_SESSION_TIMEOUT_MINUTES=60
KANDOR_PAGE_SIZE=25
KANDOR_AUDIT_RETENTION_DAYS=365

# Idempotent development seed. Values are read only from the environment.
KANDOR_SEED_DEVELOPMENT=true
KANDOR_ADMIN_PASSWORD=CHANGE_ME_admin_development_password_1
KANDOR_OPERATOR_PASSWORD=CHANGE_ME_operator_development_password_1
KANDOR_VIEWER_PASSWORD=CHANGE_ME_viewer_development_password_1

# Development-only scaled-agent bootstrap. Ignored outside development mode.
KANDOR_DEMO_BOOTSTRAP_SECRET=CHANGE_ME_demo_bootstrap_secret_at_least_32_characters
KANDOR_SERVER_URL=http://kandor-backend:8000
KANDOR_CONFIG=/var/lib/kandor/agent.json
KANDOR_HEARTBEAT_INTERVAL=30
KANDOR_POLL_INTERVAL=5
# Required only for the isolated local Compose demo because its service URL is HTTP.
KANDOR_ALLOW_INSECURE_HTTP=true

# Frontend uses same-origin /api by default when served by its nginx container.
VITE_API_URL=
