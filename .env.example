# ASHBORNE local development configuration. Copy to .env and change every value
# marked CHANGE_ME before exposing the stack beyond localhost.
ASHBORNE_ENVIRONMENT=development
ASHBORNE_DEBUG=false
ASHBORNE_LOG_LEVEL=INFO
ASHBORNE_API_PORT=8000
ASHBORNE_UI_PORT=3000
# Compose applies Alembic before startup; do not mutate schemas from app workers.
ASHBORNE_AUTO_CREATE_TABLES=false

# Database and Redis
POSTGRES_DB=ashborne
POSTGRES_USER=ashborne_owner
POSTGRES_PASSWORD=CHANGE_ME_local_database_admin_password
# The application role is created by docker/postgres/init-app-role.sh with no
# superuser, database-creation, or role-creation privileges.
ASHBORNE_DB_USER=ashborne
ASHBORNE_DB_PASSWORD=CHANGE_ME_local_database_app_password
ASHBORNE_DATABASE_URL=postgresql+asyncpg://ashborne:CHANGE_ME_local_database_app_password@ashborne-postgres:5432/ashborne
REDIS_PASSWORD=CHANGE_ME_local_redis_password
ASHBORNE_REDIS_URL=redis://:CHANGE_ME_local_redis_password@ashborne-redis:6379/0

# Generate with: openssl rand -hex 32
ASHBORNE_SECRET_KEY=CHANGE_ME_64_character_random_signing_secret_0000000000000000000000
ASHBORNE_JWT_ISSUER=ashborne
ASHBORNE_JWT_AUDIENCE=ashborne-ui
ASHBORNE_REFRESH_TOKEN_DAYS=7
ASHBORNE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ASHBORNE_TRUSTED_HOSTS=localhost,127.0.0.1,ashborne-backend
# Compose assigns this address only to the frontend reverse proxy. Keep these
# values aligned if the proxy subnet must change due to a local network conflict.
ASHBORNE_PROXY_SUBNET=172.30.254.0/28
ASHBORNE_FRONTEND_PROXY_IP=172.30.254.10
ASHBORNE_FORWARDED_ALLOW_IPS=172.30.254.10

# Request and authentication abuse controls
ASHBORNE_MAX_REQUEST_BYTES=1048576
ASHBORNE_RATE_LIMIT_REQUESTS=300
ASHBORNE_RATE_LIMIT_WINDOW_SECONDS=60
ASHBORNE_LOGIN_RATE_LIMIT_REQUESTS=10

# Health and retention defaults
ASHBORNE_HEARTBEAT_INTERVAL_SECONDS=30
ASHBORNE_DEGRADED_THRESHOLD_SECONDS=60
ASHBORNE_OFFLINE_THRESHOLD_SECONDS=300
ASHBORNE_TASK_EXPIRATION_SECONDS=3600
ASHBORNE_SESSION_TIMEOUT_MINUTES=60
ASHBORNE_PAGE_SIZE=25
ASHBORNE_AUDIT_RETENTION_DAYS=365

# Idempotent development seed. Values are read only from the environment.
ASHBORNE_SEED_DEVELOPMENT=true
ASHBORNE_ADMIN_PASSWORD=CHANGE_ME_admin_development_password_1
ASHBORNE_OPERATOR_PASSWORD=CHANGE_ME_operator_development_password_1
ASHBORNE_VIEWER_PASSWORD=CHANGE_ME_viewer_development_password_1

# Development-only demo-agent bootstrap. Ignored outside development mode.
# Compose deliberately pins the demo agent to its internal backend URL, config
# path, and isolated-lab HTTP mode. Use CLI flags or process environment values
# when running a standalone agent outside Compose.
ASHBORNE_DEMO_BOOTSTRAP_SECRET=CHANGE_ME_demo_bootstrap_secret_at_least_32_characters
ASHBORNE_HEARTBEAT_INTERVAL=30
ASHBORNE_POLL_INTERVAL=5

# Frontend uses same-origin /api by default when served by its nginx container.
VITE_API_URL=
